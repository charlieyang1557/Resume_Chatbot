# Required for Claude LLM and query rewriting
ANTHROPIC_API_KEY=sk-ant-...

# LLM backend: "claude" (default with API key), "simple" (offline), "openai", "ollama"
LLM_BACKEND=claude

# Hybrid retriever alpha: 0.0 = pure BM25, 1.0 = pure dense, 0.5 = balanced (default)
RETRIEVER_ALPHA=1.0

# Rate limits (in-memory, resets on restart)
RATE_LIMIT_PER_IP=20
RATE_LIMIT_DAILY=100

# Optional: Override Claude model
# CLAUDE_MODEL=claude-sonnet-4-20250514
